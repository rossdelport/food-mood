{
  "expo": {
    "name": "Food Mood",
    "slug": "food-mood",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foodmood",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rossdelport.foodmood",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Food Mood uses the camera to capture photos of your meals.",
        "NSPhotoLibraryUsageDescription": "Food Mood accesses your photos so you can log a meal from your library."
      }
    },
    "android": {
      "package": "com.rossdelport.foodmood",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#FAF8F4",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 240
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Food Mood uses the camera to capture photos of your meals.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Food Mood accesses your photos so you can log a meal from your library."
        }
      ],
      "expo-notifications",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4fbc175-a5e4-44d9-9de1-767d568fe003"
      }
    }
  }
}
